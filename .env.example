# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=

# REQUIRED. Who receives booking and enquiry notifications.
#
# While you have no verified domain (see MGH_FROM_EMAIL below), Resend is in
# sandbox mode and will ONLY deliver to the email address that owns the Resend
# account. So set this to that address or nothing will arrive at all — the
# send comes back 403.
#
# Once a domain is verified this becomes a normal recipient list and accepts
# several addresses, comma-separated.
MGH_ADMIN_EMAIL=

# Sender, as `Name <address>`. LEAVE THIS UNSET while you are on the sandbox.
#
# Unset  -> sandbox mode: sends from `onboarding@resend.dev`, delivers only to
#           MGH_ADMIN_EMAIL, and customer-facing mail is redirected there too
#           with a banner naming who it was meant for, so you can still read
#           and review the templates.
# Set    -> real delivery to real customers. The domain must be verified in
#           Resend first (add the DNS records it gives you).
#
# MGH_FROM_EMAIL="Mlangeni Grand Hospitality <bookings@mlangeni.co.za>"

# Optional Reply-To on customer-facing mail.
MGH_REPLY_TO=

# Used to build dashboard deep-links inside emails. Links are omitted if unset.
NEXT_PUBLIC_SITE_URL=
