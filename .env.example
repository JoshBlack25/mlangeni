# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=

# REQUIRED. Who receives booking and enquiry notifications.
#
# While you have no verified domain (see MGH_FROM_EMAIL below), Resend is in
# sandbox mode and will ONLY deliver to the email address that owns the Resend
# account. So set this to that address or nothing will arrive at all — the
# send comes back 403.
#
# Once a domain is verified this becomes a normal recipient list and accepts
# several addresses, comma-separated.
MGH_ADMIN_EMAIL=

# Sender, as `Name <address>`. LEAVE THIS UNSET while you are on the sandbox.
#
# Unset  -> sandbox mode: sends from `onboarding@resend.dev`, delivers only to
#           MGH_ADMIN_EMAIL, and customer-facing mail is redirected there too
#           with a banner naming who it was meant for, so you can still read
#           and review the templates.
# Set    -> real delivery to real customers. The domain must be verified in
#           Resend first (add the DNS records it gives you).
#
# MGH_FROM_EMAIL="Mlangeni Grand Hospitality <bookings@mlangeni.co.za>"

# Optional Reply-To on customer-facing mail.
MGH_REPLY_TO=

# The public origin, e.g. https://mlangeni.co.za (no trailing slash).
# REQUIRED in production: canonical URLs, sitemap.xml, robots.txt and the
# social-share image are absolute and built from it. Also used for dashboard
# deep-links inside emails. On Vercel the production domain is used if unset.
NEXT_PUBLIC_SITE_URL=

# Business phone / WhatsApp number, international format, digits only
# (e.g. 27821234567). The Support page's Call and WhatsApp options and the
# enquiry form's WhatsApp hand-off stay hidden until this is set.
NEXT_PUBLIC_BUSINESS_PHONE=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── PayFast ───────────────────────────────────────────────────────────────
# The merchant account is the admin's: customer payments land in it.
# Sandbox credentials come from https://sandbox.payfast.co.za (no real money).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Optional. Must match the passphrase in the PayFast dashboard exactly.
PAYFAST_PASSPHRASE=
# "false" for live. Anything else (or unset) = sandbox.
PAYFAST_SANDBOX=true
# Optional. Full public URL of /api/payfast/notify. PayFast calls it
# server-to-server, so localhost doesn't work — use a tunnel (ngrok) locally.
# PAYFAST_NOTIFY_URL=

# Server-only (bypasses RLS). Needed by the PayFast webhook to mark invoices
# paid. Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
